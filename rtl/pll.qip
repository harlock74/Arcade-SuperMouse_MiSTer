# Based on the pinned official template PLL, locally configured for 25 MHz.
set_global_assignment -name IP_TOOL_NAME altera_pll -entity pll
set_global_assignment -name IP_TOOL_VERSION 17.0 -entity pll
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll.v]
set_global_assignment -name VERILOG_FILE [file join $::quartus(qip_path) pll/pll_0002.v]
